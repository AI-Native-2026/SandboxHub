# ===== SandboxHub environment (copy to .env, never commit) =====

# --- VM access (for scripts/vm.py) ---
VM_HOST=<vm-ip>
VM_USER=<ssh-user>
VM_PASS=<ssh-password>
VM_PROJECT_DIR=/home/ubuntu/SandboxHub

# --- PostgreSQL ---
POSTGRES_DB=sandboxhub
POSTGRES_USER=sandboxhub
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PORT=6380

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=sandboxhub
KEYCLOAK_WEB_CLIENT=sandboxhub-web
KEYCLOAK_BFF_CLIENT=sandboxhub-bff
KEYCLOAK_BFF_CLIENT_SECRET=change-me

# --- BFF ---
BFF_PORT=8001
BFF_DATABASE_URL=postgresql+psycopg://sandboxhub:change-me@postgres:5432/sandboxhub
BFF_REDIS_URL=redis://redis:6379/0
BFF_JWKS_URL=http://keycloak:8080/realms/sandboxhub/protocol/openid-connect/certs
BFF_TOKEN_ISSUER=http://localhost:8180/realms/sandboxhub
BFF_CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- OpenSandbox upstream (BFF-internal only) ---
OSB_BASE_URL=http://host.docker.internal:8090
OSB_API_KEY=osb-course-key-2026

# --- Web ---
WEB_PORT=8081
WEB_KEYCLOAK_URL=http://localhost:8180
WEB_KEYCLOAK_REALM=sandboxhub
WEB_KEYCLOAK_CLIENT_ID=sandboxhub-web
WEB_API_BASE=/api/v1
